TOKEN_FILE = os.path.expanduser('~/.buzz_token')


def generate_passphrase(n: int = 4) -> str:
    """Return n random words joined by hyphens."""
    return '-'.join(random.choices(_WORDS, k=n))


def _requests():
    """Return the requests module, exiting with a helpful message if missing."""
    try:
        import requests as _r
        return _r
    except ImportError:
        print(
            "Error: the 'requests' package is required.\n"
            "Install it with:  pip install requests",
            file=sys.stderr,
        )
        sys.exit(1)


def setup_token(server_override: str = None) -> tuple[str, str]:
    """
    Interactive flow to obtain and save an API token.

    Prompts for server URL (if not supplied), username, and password,
    logs in via the web session, generates a token, and writes it to
    ~/.buzz_token with mode 0600.

    Returns (token, server_url).
    """
    import getpass

    requests = _requests()

    print("No token found. Let's set one up.\n")

    server = server_override
    if not server:
        server = input("Buzzdrop server URL (e.g. https://buzzdrop.example.com): ").strip().rstrip('/')
    if not server:
        print("Error: server URL is required.", file=sys.stderr)
        sys.exit(1)

    username = input("Username: ").strip()
    if not username:
        print("Error: username is required.", file=sys.stderr)
        sys.exit(1)

    password = getpass.getpass("Password: ")
    if not password:
        print("Error: password is required.", file=sys.stderr)
        sys.exit(1)

    session = requests.Session()

    # Log in
    try:
        resp = session.post(
            f"{server}/login",
            data={'username': username, 'password': password},
            allow_redirects=True,
            timeout=15,
        )
    except requests.ConnectionError:
        print(f"Error: could not connect to {server}", file=sys.stderr)
        sys.exit(1)
    except requests.RequestException as exc:
        print(f"Error: login request failed: {exc}", file=sys.stderr)
        sys.exit(1)

    # Buzzdrop redirects to / on success and back to /login on failure.
    # Check for the session cookie as a reliable success signal.
    if 'session' not in session.cookies:
        print("Error: login failed — check your username and password.", file=sys.stderr)
        sys.exit(1)

    # Generate token for self
    try:
        resp = session.post(
            f"{server}/api/token",
            json={'username': username},
            timeout=15,
        )
    except requests.RequestException as exc:
        print(f"Error: token request failed: {exc}", file=sys.stderr)
        sys.exit(1)

    if resp.status_code == 403:
        print("Error: your account does not have permission to generate tokens.", file=sys.stderr)
        sys.exit(1)
    if not resp.ok:
        msg = f"Server returned {resp.status_code}"
        try:
            msg += f": {resp.json().get('error', '')}"
        except Exception:
            pass
        print(f"Error: {msg}", file=sys.stderr)
        sys.exit(1)

    token = resp.json().get('token')
    if not token:
        print("Error: server did not return a token.", file=sys.stderr)
        sys.exit(1)

    # Write ~/.buzz_token with restricted permissions
    token_data = json.dumps({'token': token, 'server': server}, indent=2) + '\n'
    # Open with O_CREAT | O_WRONLY | O_TRUNC and mode 0600 atomically
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, token_data.encode())
    finally:
        os.close(fd)

    print(f"\nToken saved to {TOKEN_FILE}\n")
    return token, server


def read_token_file(server_override: str = None) -> tuple[str, str]:
    """
    Read ~/.buzz_token and return (token, server_url).

    If the file is missing, runs the interactive setup flow, saves the token,
    then exits with a message asking the user to repeat their command.
    """
    if not os.path.exists(TOKEN_FILE):
        print(f"No token found at {TOKEN_FILE} — let's get one now.\n")
        setup_token(server_override=server_override)
        print("All set! Now repeat your command.")
        sys.exit(0)

    try:
        with open(TOKEN_FILE) as fh:
            data = json.load(fh)
    except json.JSONDecodeError as exc:
        print(f"Error: {TOKEN_FILE} is not valid JSON: {exc}", file=sys.stderr)
        sys.exit(1)

    token = data.get('token')
    server = server_override or data.get('server')
    if not token or not server:
        print(
            f"Error: {TOKEN_FILE} must have both 'token' and 'server' fields.",
            file=sys.stderr,
        )
        sys.exit(1)

    return token, server.rstrip('/')


def encrypt_file(file_bytes: bytes, password: str) -> bytes:
    """
    Encrypt file_bytes with password using AES-GCM + PBKDF2-SHA256.

    Output format (same as the Buzzdrop browser client):
        salt (16 bytes) + iv (12 bytes) + AES-GCM ciphertext (with 16-byte tag)

    The plaintext has the magic header b'BKP-FILE' prepended before encryption
    so the browser can detect a wrong password.
    """
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
        from cryptography.hazmat.primitives import hashes
    except ImportError:
        print(
            "Error: the 'cryptography' package is required.\n"
            "Install it with:  pip install cryptography",
            file=sys.stderr,
        )
        sys.exit(1)

    salt = os.urandom(16)
    iv = os.urandom(12)

    kdf = PBKDF2HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=100_000,
    )
    key = kdf.derive(password.encode('utf-8'))

    plaintext = b'BKP-FILE' + file_bytes
    ciphertext = AESGCM(key).encrypt(iv, plaintext, None)
    return salt + iv + ciphertext


def upload(server: str, token: str, filename: str, encrypted: bytes, expiry: str = None) -> dict:
    """POST the encrypted blob to /upload and return the JSON response."""
    requests = _requests()

    files = {
        'file': (os.path.basename(filename), BytesIO(encrypted), 'application/octet-stream'),
    }
    data = {}
    if expiry:
        data['expiry'] = expiry

    try:
        resp = requests.post(
            f"{server}/upload",
            files=files,
            data=data,
            headers={
                'Authorization': f'Bearer {token}',
                'X-Requested-With': 'XMLHttpRequest',
            },
            timeout=120,
        )
    except requests.ConnectionError:
        print(f"Error: could not connect to {server}", file=sys.stderr)
        sys.exit(1)
    except requests.Timeout:
        print("Error: upload timed out", file=sys.stderr)
        sys.exit(1)
    except requests.RequestException as exc:
        print(f"Error: upload failed: {exc}", file=sys.stderr)
        sys.exit(1)

    if resp.status_code == 401:
        print(
            "Error: authentication failed — check your token in ~/.buzz_token",
            file=sys.stderr,
        )
        sys.exit(1)

    if not resp.ok:
        msg = f"Server returned {resp.status_code}"
        try:
            msg += f": {resp.json().get('error', '')}"
        except Exception:
            pass
        print(f"Error: {msg}", file=sys.stderr)
        sys.exit(1)

    return resp.json()


def main():
    parser = argparse.ArgumentParser(
        prog='buzz',
        description='Share a file via Buzzdrop (one-time self-destructing link).',
    )
    parser.add_argument('file', help='File to share')
    parser.add_argument(
        '-p', '--password',
        help='Encryption password (default: random 4-word passphrase)',
    )
    parser.add_argument(
        '--expiry',
        metavar='DATETIME',
        help='Optional expiry datetime in ISO format, e.g. 2025-12-31T23:59',
    )
    parser.add_argument(
        '--server',
        metavar='URL',
        help='Override server URL from ~/.buzz_token',
    )
    args = parser.parse_args()

    token, server = read_token_file(server_override=args.server)

    # Determine password
    password = args.password
    password_generated = password is None
    if password_generated:
        password = generate_passphrase()

    # Read file
    if not os.path.isfile(args.file):
        print(f"Error: file not found: {args.file}", file=sys.stderr)
        sys.exit(1)
    try:
        with open(args.file, 'rb') as fh:
            file_bytes = fh.read()
    except OSError as exc:
        print(f"Error: cannot read {args.file}: {exc}", file=sys.stderr)
        sys.exit(1)

    # Encrypt
    print(f"Encrypting {os.path.basename(args.file)}...", end=' ', flush=True)
    encrypted = encrypt_file(file_bytes, password)
    print("done")

    # Upload
    print("Uploading...", end=' ', flush=True)
    result = upload(server, token, args.file, encrypted, expiry=args.expiry)
    print("done\n")

    share_link = result.get('share_link') or f"{server}/view/{result['file_id']}"

    print(f"Share link:     {share_link}")
    if password_generated:
        print(f"Password:       {password}")
    print()
    print(f"One-click link: {share_link}#{password}")


if __name__ == '__main__':
    main()
