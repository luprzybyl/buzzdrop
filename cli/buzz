#!/usr/bin/env python3
"""
buzz — Buzzdrop CLI for sharing files from the command line.

Authentication: reads ~/.buzz_token (JSON with 'token' and 'server' fields).
Encryption: AES-GCM with PBKDF2-SHA256 key derivation, compatible with the
Buzzdrop web UI.

Usage:
    buzz file.pdf
    buzz file.pdf -p my-passphrase
    buzz file.pdf --expiry 2025-12-31T23:59
"""

