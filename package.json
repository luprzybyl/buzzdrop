{
  "name": "buzzdrop",
  "version": "1.0.0",
  "description": "Buzzdrop UI asset build tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/tailwind.css -o ./static/css/app.css --minify",
    "test:unit": "node --test tests/js/*.test.js",
    "test:dom": "vitest run --coverage",
    "test": "npm run test:unit && npm run test:dom",
    "fixtures": "python tests/fixtures/render_dom_fixtures.py",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  }
}
