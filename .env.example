# Flask Secret Key (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production
# Separate stable secret for deterministic API token hashing.
# REQUIRED in production (FLASK_ENV=production) — one secret must not protect
# both session cookies and token hashes. Optional in development, where it
# falls back to FLASK_SECRET_KEY.
# TOKEN_HASH_SECRET=your-token-hash-secret-here

# Session cookie hardening
# Secure defaults to true in production and false in development/testing
# (local dev usually runs over plain HTTP). Set to true explicitly when
# serving dev over HTTPS, or to false for an HTTP-only LAN deployment.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SameSite: Lax (default), Strict, or None (None requires SESSION_COOKIE_SECURE=true)
# SESSION_COOKIE_SAMESITE=Lax
# Permanent session lifetime in seconds (default 28800 = 8 hours)
# PERMANENT_SESSION_LIFETIME=28800

# User Management
# Format: FLASK_USER_N=username:password:is_admin[:email]
# Passwords are hashed automatically using PBKDF2-SHA256
FLASK_USER_1=admin:password:true
# FLASK_USER_2=user1:pass123:false:user1@example.com
# FLASK_USER_3=user2:pass456:false

# SMTP / uploader open notifications
# Notifications are sent after Buzzdrop receives the recipient's decryption result.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=buzzdrop@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Upload configuration
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx,xls,xlsx,mp4
MAX_CONTENT_LENGTH=104857600

# Database configuration
# Scheme selects the storage backend. Only sqlite:/// is implemented today;
# postgresql://, mysql://, oracle:// will raise NotImplementedError until a
# backend implementing FileStore/TokenStore registers for the scheme.
DATABASE_URL=sqlite:///buzzdrop.db
# Docker compose overrides this to sqlite:///data/buzzdrop.db so the
# database and its WAL sidecars live on the mounted ./data directory.
# Deprecated fallback used only when DATABASE_URL is unset:
# DATABASE_PATH=buzzdrop.db

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_HEADERS_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
# Override per-route limits as needed for your environment
LOGIN_RATE_LIMIT=10 per minute
API_TOKEN_RATE_LIMIT=10 per hour
# NOTE: upload is two-phase — POST /upload/begin and POST /upload share
# this bucket, so a complete upload consumes 2 hits (effective 15 files/h
# at the default of 30).
UPLOAD_RATE_LIMIT=30 per hour
PUBLIC_FILE_RATE_LIMIT=60 per hour


STORAGE_BACKEND=local # or s3
# NOTE: the values below are placeholders — the app refuses to start with
# STORAGE_BACKEND=s3 until you replace them with real credentials.
S3_BUCKET=bucketname
S3_ACCESS_KEY=youraccesskey
S3_SECRET_KEY=yoursecretkey
S3_REGION=eu-central-1

# Server-gated key release (docs/true-one-time.md §6) — the only
# share format, always on.
# Per-file_id rate limit on /release (rotating IPs don't reset it)
KEY_RELEASE_RATE_LIMIT=10 per minute
# Failed verifier attempts before lockout (default 1 = a single wrong
# password locks the share — true one-attempt semantics; raise to allow
# recipient typos, at the cost of more online guesses)
KEY_RELEASE_MAX_ATTEMPTS=1
# Burn the share on lockout (default true): the file_keys row is
# deleted, H+V destroyed — the ciphertext is mathematically dead.
# false keeps the row but permanently refuses releases — there is
# currently no unlock path, so that also bricks the share in practice.
KEY_RELEASE_BURN_ON_LOCKOUT=true
# TTL for pending shares (/upload/begin called but /upload never finished)
KEY_SHARE_PENDING_TTL_SECONDS=3600
# Seconds after a successful release (correct password) within which the
# ciphertext must be downloaded; afterwards the drop expires and the
# expiry sweep deletes the blob
KEY_RELEASE_DOWNLOAD_TTL_SECONDS=600

# Source code link for the footer and every repository link (AGPL-3.0
# §13). Unset or empty uses the upstream repository. If you run a
# modified Buzzdrop, point this at the source of the code you serve.
# SOURCE_CODE_URL=https://github.com/buzzdrop/buzzdrop

# Expiry sweep
# Expired drops are always destroyed once at startup; this interval
# (seconds) additionally re-sweeps on a background daemon thread, so a
# drop nobody ever opens still loses its ciphertext and key share.
# Set to 0 to disable the periodic sweep.
EXPIRY_SWEEP_INTERVAL_SECONDS=300
