#!/bin/sh
# Keep the committed DOM-test fixtures in sync with the templates.
#
# When a commit touches anything the fixtures are rendered from
# (templates/, the root Python modules, the generator itself), re-render
# them and stage the result, so CI's drift check never trips.
# Activated by `npm install` (package.json "prepare" sets core.hooksPath).
# Skip once with: git commit --no-verify

if ! git diff --cached --name-only --diff-filter=ACMRD \
    | grep -qE '^(templates/|[^/]+\.py$|\.env\.example$|tests/fixtures/)'; then
    exit 0
fi

if [ -x .venv/bin/python ]; then
    PYTHON=.venv/bin/python
else
    PYTHON=python3
fi

if ! "$PYTHON" tests/fixtures/render_dom_fixtures.py >/dev/null; then
    echo "pre-commit: rendering DOM fixtures failed (see above); commit aborted." >&2
    echo "pre-commit: fix the error, or skip once with git commit --no-verify." >&2
    exit 1
fi

git add -A tests/js/fixtures/html
