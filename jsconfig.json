{
    // Type-checks the browser JS and its tests from JSDoc, with no build step:
    // tsc only checks (noEmit); the browser keeps loading the same .js files.
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["static/js/**/*.js", "tests/js/**/*.js"],
    // `exclude` only filters `include`: eff-wordlist.js (data) is still checked
    // through passphrase.js's import, which a plain string array passes as is.
    "exclude": ["static/js/eff-wordlist.js", "tests/js/fixtures"]
}
